# Postgres connection string used by the API and by drizzle-kit.
DATABASE_URL=postgres://user:password@localhost:5432/fraud_iq

# Port the API listens on. Hosts that inject their own PORT override this.
PORT=3001

# Optional. Absolute path to the built frontend. Unset is correct in almost all
# cases: the API looks for apps/web/dist/public next to its own bundle and
# serves the game from there when it exists.
# WEB_DIST=
