{
  "name": "fraud-iq",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev:web": "pnpm --filter @fraud-iq/web run dev",
    "dev:api": "PORT=3001 pnpm --filter @fraud-iq/api run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "node --enable-source-maps apps/api/dist/index.mjs",
    "db:push": "pnpm --filter @fraud-iq/db run push-force",
    "test": "pnpm -r --if-present run test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --if-present run typecheck"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
